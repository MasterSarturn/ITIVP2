# ================================================================
# Ручные тесты API (расширение REST Client для VS Code).
# Выполняйте запросы сверху вниз: токены и ID товара подставляются
# автоматически из ответов именованных запросов (# @name ...).
# В заголовке каждого запроса указан ожидаемый статус.
#
# refresh-токен приходит в httpOnly-cookie (Set-Cookie) и подставляется
# REST Client автоматически: /auth/refresh и /auth/logout читают его из cookie.
# Создание, изменение и удаление товаров доступны только администратору
# (ADMIN_EMAIL / ADMIN_PASSWORD из .env, создаётся сидером).
#
# Профиль в конце удаляется, а email остаётся занятым. Перед повторным
# прогоном поменяйте @email и @lockEmail или выполните npm run db:reset.
# ================================================================

@baseUrl = http://localhost:3000
@email = ivan@example.com
@password = secret123
@lockEmail = locked@example.com
@adminEmail = admin@example.com
@adminPassword = admin123

@accessToken = {{login.response.body.accessToken}}
@adminToken = {{adminLogin.response.body.accessToken}}
@productId = {{createProduct.response.body.id}}

# ======================== Аутентификация ========================

### Регистрация (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "firstName": "Иван",
  "lastName": "Иванов"
}

### Повторная регистрация с тем же email (409)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Регистрация с невалидными данными (400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123"
}

### Вход (200) — accessToken в теле, refreshToken в cookie
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Вход без пароля (400)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}"
}

# =========================== Профиль ============================

### Профиль без токена (401)
GET {{baseUrl}}/profile

### Профиль с некорректным токеном (401)
GET {{baseUrl}}/profile
Authorization: Bearer invalid.token.value

### Профиль с валидным токеном (200)
GET {{baseUrl}}/profile
Authorization: Bearer {{accessToken}}

### Изменение профиля (200)
PATCH {{baseUrl}}/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Пётр",
  "lastName": "Петров"
}

### Изменение профиля без полей (400)
PATCH {{baseUrl}}/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

# ============================ Товары ============================

### Вход администратора (200)
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Список товаров, страница 1 по умолчанию (200, без токена)
GET {{baseUrl}}/api/products

### Список товаров, страница 2 (200, items может быть пустым)
GET {{baseUrl}}/api/products?page=2

### Некорректная страница (400)
GET {{baseUrl}}/api/products?page=0

### Некорректная страница (400)
GET {{baseUrl}}/api/products?page=abc

### Создать товар админом (201) — ID сохраняется в @productId
# @name createProduct
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Новая электронная книга",
  "category": "book",
  "description": "Книга для изучения Node.js",
  "price": 799,
  "author": "Иван Иванов",
  "downloadUrl": "https://example.com/book",
  "stockQuantity": 10
}

### Получить товар по ID (200, без токена)
GET {{baseUrl}}/api/products/{{productId}}

### Обновить товар админом (200)
PUT {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Обновленная книга",
  "category": "book",
  "description": "Новое описание книги",
  "price": 899,
  "author": "Иван Иванов",
  "downloadUrl": "https://example.com/updated-book"
}

### Удалить товар обычным пользователем (403)
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{accessToken}}

### Удалить товар админом (204)
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}

### Получить удалённый товар (404)
GET {{baseUrl}}/api/products/{{productId}}

### Некорректный ID товара (400)
GET {{baseUrl}}/api/products/abc

### Создать товар обычным пользователем (403)
POST {{baseUrl}}/api/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Книга",
  "category": "book",
  "description": "Нужна роль admin",
  "price": 100,
  "author": "Автор",
  "downloadUrl": "https://example.com/forbidden"
}

### Создать товар без токена (401)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Защищённая книга",
  "category": "book",
  "description": "Требует авторизации",
  "price": 100,
  "author": "Автор",
  "downloadUrl": "https://example.com/protected"
}

### Создать товар с невалидными данными (400)
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "category": "wrong",
  "price": -10
}

### Неизвестный маршрут (404)
GET {{baseUrl}}/unknown

# ====================== Обновление и выход ======================

### Вход обычным пользователем (200) — cookie снова принадлежит ему
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Обновление токенов (200) — refresh берётся из cookie, тело не нужно
# @name refresh
POST {{baseUrl}}/auth/refresh

### Выход (204) — отзывает access-токен и refresh из cookie, cookie очищается
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{refresh.response.body.accessToken}}

### Профиль после выхода (401 — токен отозван)
GET {{baseUrl}}/profile
Authorization: Bearer {{refresh.response.body.accessToken}}

### Refresh без cookie (401)
POST {{baseUrl}}/auth/refresh

# ======================= Удаление профиля =======================

### Повторный вход (200)
# @name relogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Удаление профиля (204)
DELETE {{baseUrl}}/profile
Authorization: Bearer {{relogin.response.body.accessToken}}

### Профиль после удаления (401 — все токены отозваны)
GET {{baseUrl}}/profile
Authorization: Bearer {{relogin.response.body.accessToken}}

### Вход в удалённый профиль (401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

# =================== Блокировка после 5 ошибок ==================

### Регистрация отдельного пользователя для проверки блокировки (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{lockEmail}}",
  "password": "{{password}}"
}

### Неверный пароль: выполните 5 раз (1–4 → 401, 5-й и далее → 423)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{lockEmail}}",
  "password": "wrong-password"
}

### Верный пароль во время блокировки (423, блокировка на 15 минут)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{lockEmail}}",
  "password": "{{password}}"
}

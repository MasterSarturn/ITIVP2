# ================================================================
# Ручные тесты API (расширение REST Client для VS Code).
# Выполняйте запросы сверху вниз: токены и ID товара подставляются
# автоматически из ответов именованных запросов (# @name ...).
# В заголовке каждого запроса указан ожидаемый статус.
#
# refresh-токен приходит в httpOnly-cookie (Set-Cookie) и подставляется
# REST Client автоматически: /auth/refresh и /auth/logout читают его из cookie.
# Создание товаров доступно продавцу и администратору, изменение и удаление —
# владельцу и администратору (ADMIN_EMAIL / ADMIN_PASSWORD из .env, создаётся сидером).
#
# Профиль в конце удаляется, а email остаётся занятым. Перед повторным
# прогоном поменяйте @email и @lockEmail или выполните npm run db:reset.
# ================================================================

@baseUrl = http://localhost:3000
@email = ivan@example.com
@password = secret123
@lockEmail = locked@example.com
@adminEmail = admin@example.com
@adminPassword = admin123

@accessToken = {{login.response.body.accessToken}}
@adminToken = {{adminLogin.response.body.accessToken}}
@productId = {{createProduct.response.body.id}}

# ======================== Аутентификация ========================

### Регистрация (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "firstName": "Иван",
  "lastName": "Иванов"
}

### Повторная регистрация с тем же email (409)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Регистрация с невалидными данными (400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123"
}

### Вход (200) — accessToken в теле, refreshToken в cookie
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Вход без пароля (400)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}"
}

# =========================== Профиль ============================

### Профиль без токена (401)
GET {{baseUrl}}/profile

### Профиль с некорректным токеном (401)
GET {{baseUrl}}/profile
Authorization: Bearer invalid.token.value

### Профиль с валидным токеном (200)
GET {{baseUrl}}/profile
Authorization: Bearer {{accessToken}}

### Изменение профиля (200)
PATCH {{baseUrl}}/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Пётр",
  "lastName": "Петров"
}

### Изменение профиля без полей (400)
PATCH {{baseUrl}}/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

# ============================ Товары ============================

### Вход администратора (200)
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Список товаров, страница 1 по умолчанию (200, без токена)
GET {{baseUrl}}/api/products

### Список товаров, страница 2 (200, items может быть пустым)
GET {{baseUrl}}/api/products?page=2

### Некорректная страница (400)
GET {{baseUrl}}/api/products?page=0

### Некорректная страница (400)
GET {{baseUrl}}/api/products?page=abc

### Создать товар админом (201) — ID сохраняется в @productId
# @name createProduct
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Новая электронная книга",
  "category": "books",
  "description": "Книга для изучения Node.js",
  "price": 799,
  "status": "published"
}

### Получить товар по ID (200, без токена)
GET {{baseUrl}}/api/products/{{productId}}

### Обновить товар админом (200)
PUT {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Обновленная книга",
  "category": "books",
  "description": "Новое описание книги",
  "price": 899.5,
  "status": "published"
}

### Удалить товар обычным пользователем (403)
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{accessToken}}

### Удалить товар админом (204) — товар переводится в archived, физически не удаляется
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}

### Получить архивный товар (404)
GET {{baseUrl}}/api/products/{{productId}}

### Некорректный ID товара, не UUID (400)
GET {{baseUrl}}/api/products/abc

### Создать товар обычным пользователем (403)
POST {{baseUrl}}/api/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Книга",
  "category": "books",
  "description": "Нужна роль admin",
  "price": 100
}

### Создать товар без токена (401)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Защищённая книга",
  "category": "books",
  "description": "Требует авторизации",
  "price": 100
}

### Создать товар с невалидными данными (400)
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "category": "wrong",
  "price": -10
}

### Неизвестный маршрут (404)
GET {{baseUrl}}/unknown

# ====================== Обновление и выход ======================

### Вход обычным пользователем (200) — cookie снова принадлежит ему
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Обновление токенов (200) — refresh берётся из cookie, тело не нужно
# @name refresh
POST {{baseUrl}}/auth/refresh

### Выход (204) — отзывает access-токен и refresh из cookie, cookie очищается
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{refresh.response.body.accessToken}}

### Профиль после выхода (401 — токен отозван)
GET {{baseUrl}}/profile
Authorization: Bearer {{refresh.response.body.accessToken}}

### Refresh без cookie (401)
POST {{baseUrl}}/auth/refresh

# ======================= Удаление профиля =======================

### Повторный вход (200)
# @name relogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Удаление профиля (204)
DELETE {{baseUrl}}/profile
Authorization: Bearer {{relogin.response.body.accessToken}}

### Профиль после удаления (401 — все токены отозваны)
GET {{baseUrl}}/profile
Authorization: Bearer {{relogin.response.body.accessToken}}

### Вход в удалённый профиль (401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

# =================== Блокировка после 5 ошибок ==================

### Регистрация отдельного пользователя для проверки блокировки (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{lockEmail}}",
  "password": "{{password}}"
}

### Неверный пароль: выполните 5 раз (1–4 → 401, 5-й и далее → 423)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{lockEmail}}",
  "password": "wrong-password"
}

### Верный пароль во время блокировки (423, блокировка на 15 минут)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{lockEmail}}",
  "password": "{{password}}"
}


# ================================================================
# Маркетплейс: роли, справочники, файлы, корзина, заказы, платежи.
# Сценарий сквозной: продавец создаёт и публикует товар, покупатель
# кладёт его в корзину, оформляет заказ, «оплачивает» и скачивает файл.
# Повторный прогон: поменяйте @sellerEmail и @buyerEmail.
#
# Webhook провайдера (POST /api/payments/webhook) требует HMAC-подпись
# тела (заголовок X-Signature), в REST Client её не посчитать, поэтому
# оплата здесь имитируется dev-эндпоинтом /api/dev/payments/:id/simulate.
# ================================================================

@sellerEmail = seller1@example.com
@buyerEmail = buyer1@example.com
@sellerToken = {{sellerLogin.response.body.accessToken}}
@buyerToken = {{buyerLogin.response.body.accessToken}}
@sellerUserId = {{sellerRegister.response.body.id}}
@marketProductId = {{createMarketProduct.response.body.id}}
@fileId = {{uploadFile.response.body.id}}
@orderId = {{createOrder.response.body.id}}
@orderItemId = {{createOrder.response.body.items[0].id}}
@paymentId = {{createPayment.response.body.id}}
@downloadId = {{requestDownload.response.body.id}}
@reviewId = {{createReview.response.body.id}}
@authorId = {{createAuthor.response.body.id}}
@categoryId = {{createCategory.response.body.id}}

# --------------------- Пользователи и роли ----------------------

### Регистрация продавца (201)
# @name sellerRegister
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{sellerEmail}}", "password": "{{password}}", "firstName": "Продавец" }

### Регистрация покупателя (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{buyerEmail}}", "password": "{{password}}", "firstName": "Покупатель" }

### Вход администратора (200)
# @name adminLogin2
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### Список пользователей админом (200)
GET {{baseUrl}}/api/admin/users?q=example
Authorization: Bearer {{adminLogin2.response.body.accessToken}}

### Список пользователей без прав администратора (403)
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{buyerToken}}

### Назначить роль seller (200) — токены продавца отзываются, нужен новый вход
PATCH {{baseUrl}}/api/admin/users/{{sellerUserId}}/role
Authorization: Bearer {{adminLogin2.response.body.accessToken}}
Content-Type: application/json

{ "role": "seller" }

### Вход продавца (200)
# @name sellerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{sellerEmail}}", "password": "{{password}}" }

### Вход покупателя (200)
# @name buyerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{buyerEmail}}", "password": "{{password}}" }

### Смена пароля с неверным текущим (403)
PATCH {{baseUrl}}/profile/password
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "currentPassword": "wrong", "newPassword": "newsecret123" }

# ------------------- Категории и авторы -------------------------

### Список категорий без токена (200)
GET {{baseUrl}}/api/categories

### Создать категорию админом (201)
# @name createCategory
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminLogin2.response.body.accessToken}}
Content-Type: application/json

{ "name": "Курсы {{sellerEmail}}", "slug": "courses-{{sellerUserId}}" }

### Создать категорию продавцом (403)
POST {{baseUrl}}/api/categories
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "name": "Другое", "slug": "other" }

### Создать автора продавцом (201)
# @name createAuthor
POST {{baseUrl}}/api/authors
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "name": "Robert C. Martin", "description": "Автор Clean Code" }

### Создать автора обычным пользователем (403)
POST {{baseUrl}}/api/authors
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "name": "Никто" }

### Поиск авторов (200)
GET {{baseUrl}}/api/authors?q=martin

### Изменить автора продавцом (403) — править может только админ
PATCH {{baseUrl}}/api/authors/{{authorId}}
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "name": "R. Martin" }

# --------------------- Товары продавца --------------------------

### Создать товар продавцом (201) — всегда draft
# @name createMarketProduct
POST {{baseUrl}}/api/products
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "name": "Clean Code",
  "category": "courses-{{sellerUserId}}",
  "description": "Книга о чистом коде",
  "price": 19.99,
  "authorIds": ["{{authorId}}"]
}

### Черновик для гостя (404)
GET {{baseUrl}}/api/products/{{marketProductId}}

### Черновик для владельца (200)
GET {{baseUrl}}/api/products/{{marketProductId}}
Authorization: Bearer {{sellerToken}}

### Собственные товары (200)
GET {{baseUrl}}/api/products/mine
Authorization: Bearer {{sellerToken}}

### Все товары админом (200)
GET {{baseUrl}}/api/admin/products?status=draft
Authorization: Bearer {{adminLogin2.response.body.accessToken}}

### Опубликовать без файлов (409)
PATCH {{baseUrl}}/api/products/{{marketProductId}}/status
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "status": "published" }

### Загрузить файл (201) — multipart/form-data, поле file
# @name uploadFile
POST {{baseUrl}}/api/products/{{marketProductId}}/files
Authorization: Bearer {{sellerToken}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="version"

v1
------boundary
Content-Disposition: form-data; name="file"; filename="clean-code.txt"
Content-Type: text/plain

Содержимое файла товара
------boundary--

### Загрузить файл чужим пользователем (403)
POST {{baseUrl}}/api/products/{{marketProductId}}/files
Authorization: Bearer {{buyerToken}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="file"; filename="x.txt"
Content-Type: text/plain

x
------boundary--

### Загрузить файл неподдерживаемого типа (415)
POST {{baseUrl}}/api/products/{{marketProductId}}/files
Authorization: Bearer {{sellerToken}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="file"; filename="script.sh"
Content-Type: text/plain

echo hi
------boundary--

### Опубликовать (200)
PATCH {{baseUrl}}/api/products/{{marketProductId}}/status
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "status": "published" }

### Удалить последний файл опубликованного товара (409)
DELETE {{baseUrl}}/api/products/{{marketProductId}}/files/{{fileId}}
Authorization: Bearer {{sellerToken}}

### Каталог с фильтрами (200)
GET {{baseUrl}}/api/products?authorId={{authorId}}&q=clean

### Обновить чужой товар обычным пользователем (403)
PUT {{baseUrl}}/api/products/{{marketProductId}}
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "name": "Взлом", "category": "books", "description": "x", "price": 1 }

# ---------------- Корзина, избранное, заказ ---------------------

### Добавить собственный товар в корзину (409)
POST {{baseUrl}}/api/cart/items
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "productId": "{{marketProductId}}" }

### Добавить товар в корзину покупателем (201)
POST {{baseUrl}}/api/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{marketProductId}}" }

### Повторное добавление (409)
POST {{baseUrl}}/api/cart/items
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{marketProductId}}" }

### Корзина (200)
GET {{baseUrl}}/api/cart
Authorization: Bearer {{buyerToken}}

### Добавить в избранное (201, повтор — 200)
POST {{baseUrl}}/api/wishlist
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "productId": "{{marketProductId}}" }

### Избранное (200)
GET {{baseUrl}}/api/wishlist
Authorization: Bearer {{buyerToken}}

### Оформить заказ (201) — корзина очищается, цена фиксируется в позиции
# @name createOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{buyerToken}}

### Свои заказы (200)
GET {{baseUrl}}/api/orders
Authorization: Bearer {{buyerToken}}

### Чужой заказ (404)
GET {{baseUrl}}/api/orders/{{orderId}}
Authorization: Bearer {{sellerToken}}

### Скачивание неоплаченного заказа (409)
POST {{baseUrl}}/api/downloads
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "orderItemId": "{{orderItemId}}", "productFileId": "{{fileId}}" }

### Создать платёж по заказу (201)
# @name createPayment
POST {{baseUrl}}/api/orders/{{orderId}}/payments
Authorization: Bearer {{buyerToken}}

### Webhook без подписи (401)
POST {{baseUrl}}/api/payments/webhook
Content-Type: application/json

{ "provider": "mock", "externalPaymentId": "x", "status": "completed", "amount": "19.99" }

### Имитация успешной оплаты провайдером (200) — только вне production
POST {{baseUrl}}/api/dev/payments/{{paymentId}}/simulate
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "status": "completed" }

### Заказ после оплаты: paid (200)
GET {{baseUrl}}/api/orders/{{orderId}}
Authorization: Bearer {{buyerToken}}

### Отмена оплаченного заказа (409)
POST {{baseUrl}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{buyerToken}}

# ----------------- Скачивание и отзывы --------------------------

### Файлы купленного товара (200)
GET {{baseUrl}}/api/products/{{marketProductId}}/files
Authorization: Bearer {{buyerToken}}

### Запросить скачивание (201)
# @name requestDownload
POST {{baseUrl}}/api/downloads
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "orderItemId": "{{orderItemId}}", "productFileId": "{{fileId}}" }

### Получить файл (200)
GET {{baseUrl}}/api/downloads/{{downloadId}}/content
Authorization: Bearer {{buyerToken}}

### Получить файл чужим пользователем (404)
GET {{baseUrl}}/api/downloads/{{downloadId}}/content
Authorization: Bearer {{sellerToken}}

### История скачиваний (200)
GET {{baseUrl}}/api/downloads
Authorization: Bearer {{buyerToken}}

### Оставить отзыв (201)
# @name createReview
POST {{baseUrl}}/api/products/{{marketProductId}}/reviews
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "rating": 5, "text": "Отличная книга" }

### Повторный отзыв (409)
POST {{baseUrl}}/api/products/{{marketProductId}}/reviews
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{ "rating": 4 }

### Отзыв продавца на свой товар (409)
POST {{baseUrl}}/api/products/{{marketProductId}}/reviews
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{ "rating": 5 }

### Отзывы товара без токена (200)
GET {{baseUrl}}/api/products/{{marketProductId}}/reviews

### Админ редактирует чужой отзыв (403)
PATCH {{baseUrl}}/api/reviews/{{reviewId}}
Authorization: Bearer {{adminLogin2.response.body.accessToken}}
Content-Type: application/json

{ "rating": 1 }

# ---------------- Продажи, админские списки ---------------------

### Продажи продавца (200) — без данных покупателя
GET {{baseUrl}}/api/seller/sales
Authorization: Bearer {{sellerToken}}

### Продажи покупателем (403)
GET {{baseUrl}}/api/seller/sales
Authorization: Bearer {{buyerToken}}

### Все заказы админом (200)
GET {{baseUrl}}/api/admin/orders?status=paid
Authorization: Bearer {{adminLogin2.response.body.accessToken}}

### Все платежи админом (200)
GET {{baseUrl}}/api/admin/payments?orderId={{orderId}}
Authorization: Bearer {{adminLogin2.response.body.accessToken}}

### Все скачивания админом (200)
GET {{baseUrl}}/api/admin/downloads?productId={{marketProductId}}
Authorization: Bearer {{adminLogin2.response.body.accessToken}}

### Возврат заказа админом (200) — доступ к скачиванию закрывается
POST {{baseUrl}}/api/admin/orders/{{orderId}}/refund
Authorization: Bearer {{adminLogin2.response.body.accessToken}}

### Скачивание после возврата (403)
GET {{baseUrl}}/api/downloads/{{downloadId}}/content
Authorization: Bearer {{buyerToken}}

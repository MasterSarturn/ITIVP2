PORT=3000
DB_NAME=digital_marketplace
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=6006
MONGO_URI=mongodb://127.0.0.1:27017/digital_marketplace
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Хранилище файлов товаров (локальный диск) и лимит загрузки в байтах
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE=52428800
# Платежи: секрет подписи webhook (HMAC-SHA256) и TTL ссылки скачивания в секундах
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
DOWNLOAD_TTL_SECONDS=300
